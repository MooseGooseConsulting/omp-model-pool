{
  "name": "omp-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Two independent oh-my-pi extensions: per-role model rotation and live Mistral discovery.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test \"packages/*/test/*.test.mjs\" \"test/**/*.test.mjs\"",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "test:live": "npm run build && node test/live/run-live.mjs"
  },
  "license": "MIT"
}
