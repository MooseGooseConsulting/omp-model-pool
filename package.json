{
  "name": "omp-model-pool",
  "version": "0.1.0",
  "description": "Round-robin model pools for oh-my-pi, selected like models (pool/<name>) in /model, role settings, or --model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "model-pool.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:live": "node test/live/run-live.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
